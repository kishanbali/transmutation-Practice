<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transmutation Engine</title>
    <style>
        body { background: #0a0c10; color: #fff; font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        button { background: #22c55e; color: #000; border: none; padding: 1.5rem 2.5rem; font-size: 1.2rem; font-weight: bold; border-radius: 12px; cursor: pointer; }
        button.playing { background: #ef4444; color: #fff; }
    </style>
</head>
<body>

    <button id="btn" onclick="toggleAudio()">Start Audio Session</button>

    <script>
        let ctx = null, osc = null, playing = false;

        function toggleAudio() {
            const btn = document.getElementById('btn');
            
            // 1. Create audio context directly inside user tap
            if (!ctx) {
                ctx = new (window.AudioContext || window.webkitAudioContext)();
            }

            if (!playing) {
                if (ctx.state === 'suspended') ctx.resume();
                
                // 2. Play audible 440 Hz tone
                osc = ctx.createOscillator();
                osc.type = 'triangle';
                osc.frequency.value = 440;
                
                const gain = ctx.createGain();
                gain.gain.value = 0.2;
                
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();

                playing = true;
                btn.innerText = "Stop Audio Session";
                btn.classList.add('playing');
            } else {
                if (osc) osc.stop();
                playing = false;
                btn.innerText = "Start Audio Session";
                btn.classList.remove('playing');
            }
        }
    </script>
</body>
</html>
